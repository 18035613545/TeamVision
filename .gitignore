# ---- Python ----
__pycache__/
*.py[cod]
.conda-pkgs/

# ---- IDE / 编辑器 ----
.trae/
.idea/
.vscode/

# ---- 构建产物（PyInstaller / Inno Setup）----
build/
dist/

# ---- 运行期生成 / 可能含凭据 ----
logs/
config.json
# 第 77 条：e2e_multiview.py 会把真实 config.json 备份成 config.json.e2e_bak，
# 其中可能含明文 frp token；必须忽略，否则 git add -A 会把 token 提交进仓库。
*.e2e_bak
accounts.json
frpc.exe

# dist-020（2026-09-24）：save_config 的原子写临时文件 config.json.<pid>.<tid>.tmp
# （common.py:1436）与损坏留存 config.json.corrupt-<ts>（common.py:1308）都可能含明文
# frp token / 口令哈希；上面的 config.json 模式匹配不到这些带后缀的变体，git add -A
# 会把它们提交进仓库（installer.iss 本身就清理 config.json.corrupt-*，说明这类文件确实落盘）。
# config.json.* 覆盖全部后缀副本，且不匹配 config.example.json 这类需要跟踪的模板文件。
config.json.*
# 同族收口（L17 残留面）：账户表的损坏留存/临时副本同样含口令哈希，
# 一并忽略；不匹配仓库里需要跟踪的 accounts 示例文件（当前无此类文件）。
accounts.json.*

# ---- 代码签名证书（自签 pfx 含私钥，禁止入库）----
certs/

# ---- 第三方依赖本地副本（可由 requirements.txt 重建）----
vendor/

# ---- 临时脚本 ----
_tmp_*.py

# ---- 本地工具记忆目录（含公网地址、隧道 ID、排查记录等，禁止入库）----
.workbuddy/

# auth-015（2026-09-20）：bootstrap 已消耗标记（与 accounts.json 同目录的数据产物，不入库）
accounts.json.bootstrap-used
